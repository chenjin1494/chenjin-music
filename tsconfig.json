{
 "compilerOptions": {
  "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
  "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
  "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
  "allowSyntheticDefaultImports": true, "types": ["node", "vite/client"],
  "baseUrl": ".", "paths": { "@/*": ["src/renderer/*"], "@shared/*": ["src/shared/*"] },
  "noEmit": true
 },
 "include": ["src/**/*.ts", "src/**/*.vue", "electron/**/*.ts", "electron.vite.config.ts", "tests/**/*.ts"]
}
