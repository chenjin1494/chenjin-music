{
  "format": "chenjin-appearance",
  "version": 1,
  "name": "琛瑾 · 星夜",
  "global": { "background": "#11111a", "color": "#f1f0fa", "mutedColor": "#9998af", "borderColor": "#ffffff10", "fontSize": 16, "radius": 16, "gap": 14, "shadow": "soft", "accentColor": "#b69aff", "animationDuration": 180 },
  "components": {
    "sidebar": { "width": 232, "background": "#171520", "radius": 16 },
    "navigation": { "radius": 10, "height": 44, "iconSize": 19, "activeBackground": "#b69aff20" },
    "topbar": { "height": 76, "background": "#191724", "borderColor": "#ffffff0d" },
    "search": { "height": 38, "radius": 12, "background": "#22202e", "fontSize": 12 },
    "content": { "padding": 30, "headingSize": 28 },
    "hero": { "background": "#242035", "radius": 18, "headingSize": 34 },
    "playlistCard": { "radius": 14, "padding": 12, "headingSize": 13, "hoverBackground": "#2b263d" },
    "trackList": { "rowHeight": 68, "radius": 10, "coverSize": 42, "fontSize": 12, "hoverBackground": "#292537", "activeBackground": "#b69aff18" },
    "player": { "height": 100, "radius": 16, "background": "#1e1b2a", "coverSize": 56, "gap": 18 },
    "queue": { "width": 380, "rowHeight": 68, "radius": 16, "coverSize": 36, "background": "#201c2b", "hoverBackground": "#302a40" },
    "lyrics": { "background": "#17141f", "color": "#f1edff", "accentColor": "#b69aff", "headingSize": 26 },
    "desktopLyrics": { "background": "#17141f88", "color": "#d9c5ff", "mutedColor": "#b6adc8", "headingSize": 36, "radius": 12 },
    "settings": { "background": "#201d2c", "radius": 16, "headingSize": 18 },
    "downloads": { "background": "#201d2c", "radius": 12, "rowHeight": 84 },
    "sources": { "background": "#201d2c", "radius": 12, "iconSize": 18 },
    "comments": { "radius": 12, "gap": 12, "color": "#f1edff", "mutedColor": "#b3a9c7" },
    "dialog": { "width": 540, "background": "#211c2e", "radius": 20, "padding": 26, "shadow": "elevated" },
    "contextMenu": { "background": "#262032", "radius": 12, "padding": 8, "fontSize": 12 },
    "button": { "radius": 9, "fontSize": 12, "animationDuration": 160 },
    "input": { "background": "#181520", "borderColor": "#ffffff14", "radius": 9, "fontSize": 12 },
    "toast": { "background": "#272136", "color": "#f1edff", "radius": 14, "shadow": "elevated" },
    "emptyState": { "color": "#b3a9c7", "headingSize": 17, "iconSize": 28 },
    "cover": { "radius": 10, "shadow": "soft" },
    "appearanceEditor": { "radius": 16, "headingSize": 18 },
    "themeSettings": { "background": "#201d2c", "headingSize": 18 },
    "audioSettings": { "background": "#201d2c", "headingSize": 18 },
    "lyricSettings": { "background": "#201d2c", "headingSize": 18 },
    "shortcutSettings": { "background": "#201d2c", "headingSize": 18 },
    "syncPanel": { "background": "#201d2c", "headingSize": 18 },
    "backupPanel": { "background": "#201d2c", "headingSize": 18 },
    "dislikePanel": { "background": "#201d2c", "headingSize": 18 },
    "updatePanel": { "background": "#201d2c", "headingSize": 18 },
    "onlinePanel": { "headingSize": 28, "padding": 30 },
    "downloadsPanel": { "headingSize": 28, "padding": 30 },
    "sourceManager": { "headingSize": 28, "padding": 30 },
    "trackDetails": { "background": "#211c2e", "width": 540, "headingSize": 20 },
    "sourceAlternatives": { "background": "#211c2e", "width": 540, "headingSize": 20 },
    "lyricEditor": { "background": "#211c2e", "width": 640, "headingSize": 20 },
    "commentsPanel": { "background": "#211c2e", "width": 640, "headingSize": 20 },
    "icon": { "strokeWidth": 1.75 }
  }
